{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemsmart.studio/schemas/v2/project-workspace.schema.json",
  "title": "ChemSmart project workspace",
  "anyOf": [
    { "$ref": "#/$defs/listRequest" },
    { "$ref": "#/$defs/listResult" },
    { "$ref": "#/$defs/readRequest" },
    { "$ref": "#/$defs/readResult" },
    { "$ref": "#/$defs/documentRequest" },
    { "$ref": "#/$defs/documentResult" },
    { "$ref": "#/$defs/validateRequest" },
    { "$ref": "#/$defs/validateResult" },
    { "$ref": "#/$defs/critiqueRequest" },
    { "$ref": "#/$defs/critiqueResult" },
    { "$ref": "#/$defs/registerCandidateRequest" },
    { "$ref": "#/$defs/candidateSummary" },
    { "$ref": "#/$defs/candidateQueryRequest" },
    { "$ref": "#/$defs/candidateResult" },
    { "$ref": "#/$defs/candidateDecisionRequest" },
    { "$ref": "#/$defs/candidateDecisionResult" }
  ],
  "$defs": {
    "program": {
      "enum": ["gaussian", "orca"]
    },
    "listedProgram": {
      "enum": ["gaussian", "orca", "xtb"]
    },
    "projectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "yamlText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "\\S"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000,
      "pattern": "\\S"
    },
    "verdict": {
      "enum": ["ok", "warn", "reject"]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "severity", "message", "extensions"],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        },
        "severity": { "enum": ["info", "warn", "reject"] },
        "message": { "$ref": "#/$defs/message" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/issue" }
    },
    "unsupportedFeatures": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "\\S"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "projectedScalar": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 12000 }
      ]
    },
    "projectedValueKind": {
      "enum": ["null", "boolean", "number", "string"]
    },
    "projectedSource": {
      "enum": ["explicit", "inherited"]
    },
    "projectedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "path", "kind", "value", "source", "recognized", "extensions"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/stableId" },
        "label": { "$ref": "#/$defs/message" },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        },
        "kind": { "$ref": "#/$defs/projectedValueKind" },
        "value": { "$ref": "#/$defs/projectedScalar" },
        "source": { "$ref": "#/$defs/projectedSource" },
        "recognized": { "type": "boolean" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "projectedSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "source", "fields", "extensions"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/stableId" },
        "label": { "$ref": "#/$defs/message" },
        "source": { "$ref": "#/$defs/projectedSource" },
        "fields": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/projectedField" }
        },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "unknownNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "kind", "value", "children", "source", "extensions"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/stableId" },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        },
        "kind": { "enum": ["mapping", "sequence", "scalar"] },
        "value": { "$ref": "#/$defs/projectedScalar" },
        "children": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/unknownNode" }
        },
        "source": { "const": "explicit" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "scalar" } }, "required": ["kind"] },
          "then": { "properties": { "children": { "maxItems": 0 } } },
          "else": { "properties": { "value": { "type": "null" } } }
        }
      ]
    },
    "documentValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "issues", "message", "extensions"],
      "properties": {
        "verdict": { "$ref": "#/$defs/verdict" },
        "issues": { "$ref": "#/$defs/issues" },
        "message": { "$ref": "#/$defs/message" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "programListing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "projectRequired", "projectNames", "extensions"],
      "properties": {
        "program": { "$ref": "#/$defs/listedProgram" },
        "projectRequired": { "type": "boolean" },
        "projectNames": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/projectName" }
        },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "program": { "const": "xtb" } },
            "required": ["program"]
          },
          "then": {
            "properties": {
              "projectRequired": { "const": false },
              "projectNames": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "projectRequired": { "const": true }
            }
          }
        }
      ]
    },
    "listRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extensions"],
      "properties": {
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "listResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "programs", "extensions"],
      "properties": {
        "schemaVersion": { "const": "1" },
        "programs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/programListing" },
          "allOf": [
            {
              "contains": {
                "properties": { "program": { "const": "gaussian" } },
                "required": ["program"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": { "program": { "const": "orca" } },
                "required": ["program"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": { "program": { "const": "xtb" } },
                "required": ["program"]
              },
              "minContains": 0,
              "maxContains": 1
            }
          ]
        },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "readRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectName", "program", "extensions"],
      "properties": {
        "projectName": { "$ref": "#/$defs/projectName" },
        "program": { "$ref": "#/$defs/program" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "readResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "projectName", "program", "yamlText", "extensions"],
      "properties": {
        "schemaVersion": { "const": "1" },
        "projectName": { "$ref": "#/$defs/projectName" },
        "program": { "$ref": "#/$defs/program" },
        "yamlText": { "$ref": "#/$defs/yamlText" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "documentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectName", "program", "extensions"],
      "properties": {
        "projectName": { "$ref": "#/$defs/projectName" },
        "program": { "$ref": "#/$defs/program" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "documentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectName",
        "program",
        "digest",
        "yamlText",
        "sections",
        "validation",
        "unknownNodes",
        "extensions"
      ],
      "properties": {
        "schemaVersion": { "const": "2" },
        "projectName": { "$ref": "#/$defs/projectName" },
        "program": { "$ref": "#/$defs/program" },
        "digest": { "$ref": "#/$defs/digest" },
        "yamlText": { "$ref": "#/$defs/yamlText" },
        "sections": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/projectedSection" }
        },
        "validation": { "$ref": "#/$defs/documentValidation" },
        "unknownNodes": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/unknownNode" }
        },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "validateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectName", "program", "yamlText", "extensions"],
      "properties": {
        "projectName": { "$ref": "#/$defs/projectName" },
        "program": { "$ref": "#/$defs/program" },
        "yamlText": { "$ref": "#/$defs/yamlText" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "validateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "projectName", "program", "verdict", "issues", "message", "extensions"],
      "properties": {
        "schemaVersion": { "const": "1" },
        "projectName": { "$ref": "#/$defs/projectName" },
        "program": { "$ref": "#/$defs/program" },
        "verdict": { "$ref": "#/$defs/verdict" },
        "issues": { "$ref": "#/$defs/issues" },
        "message": { "$ref": "#/$defs/message" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "critiqueRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectName", "program", "yamlText", "extensions"],
      "properties": {
        "projectName": { "$ref": "#/$defs/projectName" },
        "program": { "$ref": "#/$defs/program" },
        "yamlText": { "$ref": "#/$defs/yamlText" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "critiqueResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "projectName",
        "program",
        "verdict",
        "issues",
        "summary",
        "unsupportedFeatures",
        "extensions"
      ],
      "properties": {
        "schemaVersion": { "const": "1" },
        "projectName": { "$ref": "#/$defs/projectName" },
        "program": { "$ref": "#/$defs/program" },
        "verdict": { "$ref": "#/$defs/verdict" },
        "issues": { "$ref": "#/$defs/issues" },
        "summary": { "$ref": "#/$defs/summary" },
        "unsupportedFeatures": { "$ref": "#/$defs/unsupportedFeatures" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "registerCandidateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "unsupportedFeatures", "extensions"],
      "properties": {
        "document": { "$ref": "#/$defs/documentResult" },
        "unsupportedFeatures": { "$ref": "#/$defs/unsupportedFeatures" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "candidateStatus": {
      "enum": ["pending", "written", "denied", "expired", "stale", "failed"]
    },
    "candidateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "previewId",
        "projectName",
        "program",
        "baseDigest",
        "candidateDigest",
        "expectedRevision",
        "overwrite",
        "changedSections",
        "verdict",
        "issueRuleIds",
        "status",
        "createdAt",
        "expiresAt",
        "extensions"
      ],
      "properties": {
        "schemaVersion": { "const": "2" },
        "previewId": { "$ref": "common.schema.json#/$defs/stableId" },
        "projectName": { "$ref": "#/$defs/projectName" },
        "program": { "$ref": "#/$defs/program" },
        "baseDigest": { "$ref": "#/$defs/nullableDigest" },
        "candidateDigest": { "$ref": "#/$defs/digest" },
        "expectedRevision": { "$ref": "common.schema.json#/$defs/revision" },
        "overwrite": { "type": "boolean" },
        "changedSections": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "verdict": { "$ref": "#/$defs/verdict" },
        "issueRuleIds": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          }
        },
        "status": { "$ref": "#/$defs/candidateStatus" },
        "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "expiresAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "candidateQueryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "previewId", "extensions"],
      "properties": {
        "sessionId": { "$ref": "common.schema.json#/$defs/stableId" },
        "previewId": { "$ref": "common.schema.json#/$defs/stableId" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "candidateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "document", "extensions"],
      "properties": {
        "candidate": { "$ref": "#/$defs/candidateSummary" },
        "document": { "$ref": "#/$defs/documentResult" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "candidateDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "previewId",
        "baseDigest",
        "candidateDigest",
        "expectedRevision",
        "decision",
        "extensions"
      ],
      "properties": {
        "sessionId": { "$ref": "common.schema.json#/$defs/stableId" },
        "previewId": { "$ref": "common.schema.json#/$defs/stableId" },
        "baseDigest": { "$ref": "#/$defs/nullableDigest" },
        "candidateDigest": { "$ref": "#/$defs/digest" },
        "expectedRevision": { "$ref": "common.schema.json#/$defs/revision" },
        "decision": { "enum": ["allow_once", "deny"] },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "candidateDecisionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previewId", "candidateDigest", "status", "extensions"],
      "properties": {
        "previewId": { "$ref": "common.schema.json#/$defs/stableId" },
        "candidateDigest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["written", "denied", "expired", "stale", "failed"] },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    }
  }
}
