{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemsmart.studio/schemas/v2/molecule-import.schema.json",
  "title": "Opaque molecule import capability",
  "oneOf": [
    { "$ref": "#/$defs/importRequest" },
    { "$ref": "#/$defs/chunkRequest" },
    { "$ref": "#/$defs/chunkResponse" },
    { "$ref": "#/$defs/importResult" }
  ],
  "$defs": {
    "importFormat": {
      "type": "string",
      "enum": ["cjson", "sdf", "xyz"]
    },
    "importRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "format", "documentId", "sizeBytes", "extensions"],
      "properties": {
        "capabilityId": { "$ref": "common.schema.json#/$defs/stableId" },
        "format": { "$ref": "#/$defs/importFormat" },
        "documentId": { "$ref": "common.schema.json#/$defs/stableId" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "chunkRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "offset", "length", "extensions"],
      "properties": {
        "capabilityId": { "$ref": "common.schema.json#/$defs/stableId" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 134217728 },
        "length": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "chunkResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityId", "offset", "sizeBytes", "encoding", "content", "eof", "extensions"],
      "properties": {
        "capabilityId": { "$ref": "common.schema.json#/$defs/stableId" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 134217728 },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "encoding": { "const": "base64" },
        "content": { "type": "string", "maxLength": 349528 },
        "eof": { "type": "boolean" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "importResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "extensions"],
      "properties": {
        "document": { "$ref": "molecule.schema.json" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    }
  }
}
