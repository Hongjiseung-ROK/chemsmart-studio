{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemsmart.studio/schemas/v2/stage-placement-intent.schema.json",
  "title": "StagePlacementIntent",
  "type": "object",
  "additionalProperties": false,
  "required": ["documentId", "expectedRevision", "geometryHash", "atomicNumber", "bondOrder", "coordinationGeometry"],
  "properties": {
    "documentId": { "$ref": "common.schema.json#/$defs/stableId" },
    "expectedRevision": { "$ref": "common.schema.json#/$defs/revision" },
    "geometryHash": { "$ref": "common.schema.json#/$defs/geometryHash" },
    "anchorAtomId": { "$ref": "common.schema.json#/$defs/stableId" },
    "atomicNumber": { "type": "integer", "minimum": 1, "maximum": 118 },
    "bondOrder": { "enum": [1, 2, 3] },
    "coordinationGeometry": {
      "enum": ["linear", "trigonal_planar", "tetrahedral", "trigonal_bipyramidal", "square_planar", "octahedral"]
    },
    "siteIndex": { "type": "integer", "minimum": 0, "maximum": 5 }
  }
}
