{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemsmart.studio/schemas/v2/manifest.schema.json",
  "title": "ChemSmart Studio project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "documentId", "currentRevision", "activeRunId", "extensions"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "protocolVersion": { "const": "2.0.0" },
    "documentId": { "$ref": "common.schema.json#/$defs/stableId" },
    "currentRevision": { "$ref": "common.schema.json#/$defs/revision" },
    "activeRunId": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/stableId" }] },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  }
}
