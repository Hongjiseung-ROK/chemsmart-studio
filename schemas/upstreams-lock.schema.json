{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemsmart.studio/schemas/upstreams-lock.schema.json",
  "title": "ChemSmart Studio upstream lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["auditDate", "productLicense", "forkRoot", "upstreams", "excludedRuntimeSources"],
  "properties": {
    "$schema": { "type": "string" },
    "auditDate": { "type": "string", "format": "date" },
    "productLicense": { "type": "string" },
    "forkRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "upstreams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cherryStudio", "chemSmart"],
      "properties": {
        "cherryStudio": { "$ref": "#/$defs/upstream" },
        "chemSmart": { "$ref": "#/$defs/upstream" }
      }
    },
    "excludedRuntimeSources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "$defs": {
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "commit", "license", "integration", "patchState"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "type": "string" },
        "integration": { "type": "string" },
        "patchState": { "enum": ["product-fork", "read-only", "patched"] }
      }
    }
  }
}
