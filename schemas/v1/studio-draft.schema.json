{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemsmart.studio/schemas/v1/studio-draft.schema.json",
  "title": "StudioDraftSnapshot",
  "$ref": "#/$defs/studioDraftSnapshot",
  "$defs": {
    "stageGestureIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gestureId", "kind", "createdAt", "extensions"],
      "properties": {
        "gestureId": { "$ref": "common.schema.json#/$defs/stableId" },
        "kind": {
          "enum": [
            "insert_atom",
            "insert_fragment",
            "insert_ring",
            "replace_atom",
            "move_atom",
            "delete_selection",
            "set_bond",
            "set_constraint"
          ]
        },
        "atomicNumber": { "type": "integer", "minimum": 1, "maximum": 118 },
        "fragmentName": { "enum": ["water", "methane", "benzene"] },
        "anchorAtomId": { "$ref": "common.schema.json#/$defs/stableId" },
        "position": { "$ref": "common.schema.json#/$defs/vector3" },
        "bondOrder": { "type": "integer", "enum": [1, 2, 3] },
        "createdAt": { "type": "string", "format": "date-time" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "studioDraftEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "actor",
        "mode",
        "operations",
        "summary",
        "beforeHash",
        "afterHash",
        "createdAt",
        "extensions"
      ],
      "properties": {
        "entryId": { "$ref": "common.schema.json#/$defs/stableId" },
        "actor": { "enum": ["human", "agent"] },
        "mode": { "enum": ["build", "inspect", "measure", "constrain"] },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "molecule-patch.schema.json#/$defs/operation" }
        },
        "summary": { "$ref": "preview-receipt.schema.json#/$defs/studioPreviewSummary" },
        "beforeHash": { "$ref": "common.schema.json#/$defs/geometryHash" },
        "afterHash": { "$ref": "common.schema.json#/$defs/geometryHash" },
        "gesture": { "$ref": "#/$defs/stageGestureIntent" },
        "createdAt": { "type": "string", "format": "date-time" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "studioDraftSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draftId",
        "documentId",
        "baseRevision",
        "document",
        "entries",
        "cursor",
        "dirty",
        "canUndo",
        "canRedo",
        "createdAt",
        "updatedAt",
        "extensions"
      ],
      "properties": {
        "draftId": { "$ref": "common.schema.json#/$defs/stableId" },
        "documentId": { "$ref": "common.schema.json#/$defs/stableId" },
        "baseRevision": { "$ref": "common.schema.json#/$defs/revision" },
        "document": { "$ref": "molecule.schema.json" },
        "entries": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/studioDraftEntry" }
        },
        "cursor": { "type": "integer", "minimum": 0, "maximum": 128 },
        "dirty": { "type": "boolean" },
        "canUndo": { "type": "boolean" },
        "canRedo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    }
  }
}
