{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemsmart.studio/schemas/v1/rpc-envelope.schema.json",
  "title": "Newline-framed JSON-RPC 2.0 envelope",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["string", "integer"] },
        "method": { "type": "string", "minLength": 1, "maxLength": 128 },
        "params": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "type": "string", "minLength": 1, "maxLength": 128 },
        "params": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "result"],
      "properties": { "jsonrpc": { "const": "2.0" }, "id": { "type": ["string", "integer"] }, "result": {} }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "type": ["string", "integer", "null"] },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": { "code": { "type": "integer" }, "message": { "type": "string" }, "data": {} }
        }
      }
    }
  ]
}
