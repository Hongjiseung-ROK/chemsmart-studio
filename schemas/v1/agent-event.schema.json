{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chemsmart.studio/schemas/v1/agent-event.schema.json",
  "title": "AgentEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "sessionId", "sequence", "type", "timestamp", "payload", "extensions"],
  "properties": {
    "eventId": { "$ref": "common.schema.json#/$defs/stableId" },
    "sessionId": { "$ref": "common.schema.json#/$defs/stableId" },
    "sequence": { "type": "integer", "minimum": 0 },
    "type": {
      "enum": [
        "intent_gate",
        "semantic_gate",
        "tool_call",
        "approval_request",
        "approval_decision",
        "preview",
        "commit",
        "optimization_frame",
        "failure",
        "turn_completed"
      ]
    },
    "timestamp": { "$ref": "common.schema.json#/$defs/timestamp" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extensions"],
      "properties": {
        "gate": { "enum": ["intent", "semantic"] },
        "outcome": { "enum": ["passed", "failed", "needs_user", "denied"] },
        "reason": { "type": "string", "maxLength": 4096 },
        "tool": { "type": "string", "minLength": 1, "maxLength": 256 },
        "requestId": { "$ref": "common.schema.json#/$defs/stableId" },
        "decision": { "enum": ["allow_once", "allow_session", "deny"] },
        "previewId": { "$ref": "common.schema.json#/$defs/stableId" },
        "receiptId": { "$ref": "common.schema.json#/$defs/stableId" },
        "revision": { "$ref": "common.schema.json#/$defs/revision" },
        "frame": { "$ref": "optimization.schema.json#/$defs/frame" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 128 },
            "message": { "type": "string", "maxLength": 4096 }
          }
        },
        "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
      }
    },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  }
}
